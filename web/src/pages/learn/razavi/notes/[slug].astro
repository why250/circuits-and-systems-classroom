---
import Base from '../../../../layouts/Base.astro';
import { articles } from '../../../../illustrations/razavi-roadmap/plan';
export function getStaticPaths() {
  return articles.filter(item => 'note' in item && item.note).map(item => ({
    params: { slug: ('note' in item ? item.note! : '').replace('.md', '').toLowerCase() }, props: { item },
  }));
}
const { item } = Astro.props;
const note = 'note' in item ? item.note! : '';
const notes = import.meta.glob('../../../../../../*.md', { query: '?raw', import: 'default', eager: true });
const content = Object.entries(notes).find(([path]) => path.endsWith(`/${note}`))?.[1] as string | undefined;
if (!content) throw new Error(`Missing research note: ${note}`);
---
<Base title={item.title} description="Research notes with source checks and independent derivations, including model assumptions, references, and open verification items.">
  <main lang="en">
    <nav><a href="/learn/razavi/">← Back to the roadmap</a><a href={item.url} target="_blank" rel="noreferrer">Original PDF ↗</a></nav>
    <h1>{item.title}</h1>
    <p>Research note · Markdown source. Equations use LaTeX notation; image paths refer to repository materials.</p>
    <pre>{content}</pre>
  </main>
</Base>
<style>
  main { max-width: 1000px; padding: 32px 24px; margin: auto; }
  nav { display: flex; flex-wrap: wrap; gap: 24px; color: var(--brand); }
  h1 { font-size: clamp(22px, 4vw, 32px); }
  p { color: var(--ink-2); }
  pre { font: 13px/1.9 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; padding: 24px; background: var(--plot); border: 1px solid var(--rule); border-radius: 6px; }
</style>
